local function getCollectRemote()
    if CollectSignal then return CollectSignal end
    local net = ReplicatedStorage:FindFirstChild("Network")
    if net then
        local ps = net:FindFirstChild("PlotService")
        if ps and ps:FindFirstChild("CollectBalance") then
            return ps.CollectBalance
        end
        if net:FindFirstChild("CollectBalance") then
            return net.CollectBalance
        end
    end
    return nil
end

local function getMyPlot()
    local claimed = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild("Claimed")
    if not claimed then return nil end

    if MyPlotId and claimed:FindFirstChild(MyPlotId) then
        return claimed[MyPlotId]
    end

    if claimed:FindFirstChild(LocalPlayer.Name) then
        return claimed[LocalPlayer.Name]
    end
    if claimed:FindFirstChild(tostring(LocalPlayer.UserId)) then
        return claimed[tostring(LocalPlayer.UserId)]
    end

    for _, plot in ipairs(claimed:GetChildren()) do
        local owner = plot:GetAttribute("Owner") or plot:GetAttribute("Player") or plot:GetAttribute("UserId")
        if owner and (tostring(owner) == LocalPlayer.Name or tostring(owner) == tostring(LocalPlayer.UserId)) then
            return plot
        end
        local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player")
        if ownerVal and (tostring(ownerVal.Value) == LocalPlayer.Name or tostring(ownerVal.Value) == tostring(LocalPlayer.UserId)) then
            return plot
        end
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local closestPlot = nil
        local closestDist = math.huge
        for _, plot in ipairs(claimed:GetChildren()) do
            local spawn = plot:FindFirstChild("Spawn") or plot:FindFirstChild("Base")
            if spawn and spawn:IsA("BasePart") then
                local dist = (spawn.Position - hrp.Position).Magnitude
                if dist < closestDist and dist < 200 then
                    closestDist = dist
                    closestPlot = plot
                end
            end
        end
        if closestPlot then return closestPlot end
    end

    local allPlots = claimed:GetChildren()
    if #allPlots == 1 then
        return allPlots[1]
    end

    return nil
end

local function isSlotUnlocked(slotId)
    if not _G.OnlyUnlocked then return true end
    if DataController and PlotConfig and PlotConfig.GetSlotRebirthRequirement and DataController.Rebirth then
        local ok, unlocked = pcall(function()
            local rebirth = DataController.Rebirth()
            local req = PlotConfig.GetSlotRebirthRequirement(slotId)
            return rebirth >= req
        end)
        if ok then return unlocked end
    end
    return true
end

local function getSlotBalance(slotId)
    if DataController and DataController.Slots then
        local ok, slotData = pcall(function()
            local getter = DataController.Slots[tostring(slotId)]
            if getter then return getter() end
            return nil
        end)
        if ok and slotData then
            return slotData.balance or 0
        end
    end
    return 0
end

local function getAllSlots()
    local plot = getMyPlot()
    local slots = {}
    if plot then
        local slotsFolder = plot:FindFirstChild("Slots")
        if slotsFolder then
            for _, child in ipairs(slotsFolder:GetChildren()) do
                local slotNum = tonumber(child.Name)
                if slotNum then
                    local bal = child:FindFirstChild("Balance")
                    table.insert(slots, {
                        Id = slotNum,
                        Model = child,
                        Hitbox = bal and bal:FindFirstChild("Hitbox")
                    })
                end
            end
        end
    end
    table.sort(slots, function(a, b) return a.Id < b.Id end)
    return slots
end

local function collectSlot(slotId, slotInfo)
    if not isSlotUnlocked(slotId) then return false end

    if _G.SmartCollect then
        local bal = getSlotBalance(slotId)
        if bal <= 0 and DataController ~= nil then
            return false
        end
    end

    if CollectSignal then
        pcall(function()
            CollectSignal:Fire(slotId)
        end)
    else
        local remote = getCollectRemote()
        if remote and remote:IsA("RemoteEvent") then
            pcall(function()
                remote:FireServer(slotId)
            end)
        end
    end

    if _G.TouchBypass and slotInfo and slotInfo.Hitbox and firetouchinterest then
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                firetouchinterest(hrp, slotInfo.Hitbox, 0)
                task.wait(0.01)
                firetouchinterest(hrp, slotInfo.Hitbox, 1)
            end
        end)
    end

    return true
end

local function collectAllSlots()
    local slots = getAllSlots()
    if #slots > 0 then
        for _, slot in ipairs(slots) do
            collectSlot(slot.Id, slot)
            if _G.SlotDelay and _G.SlotDelay > 0 then
                task.wait(_G.SlotDelay)
            end
        end
    else
        for id = 1, 20 do
            collectSlot(id, nil)
            if _G.SlotDelay and _G.SlotDelay > 0 then
                task.wait(_G.SlotDelay)
            end
        end
    end
end

