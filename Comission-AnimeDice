local function isTowerAnimationInstance(inst)
    if not inst then return false end
    local name = inst.Name
    if name == "YourCard" or name == "EnemyCard" or name == "DamagePopup" or name == "ImpactFlash" then
        return true
    end
    local parent = inst.Parent
    if parent then
        local pName = parent.Name
        if pName == "YourCard" or pName == "EnemyCard" or pName == "Screen" or pName == "Card" or pName == "HealthBar" or pName == "Bar" or pName == "CanvasGroup" then
            return true
        end
        local pp = parent.Parent
        if pp and (pp.Name == "YourCard" or pp.Name == "EnemyCard" or pp.Name == "Screen") then
            return true
        end
    end
    local screen = getTowerScreen()
    if screen and (inst == screen or inst:IsDescendantOf(screen)) then
        return true
    end
    return false
end

local function wrapClosure(fn)
    if newcclosure then
        return newcclosure(fn)
    end
    return fn
end

local isCaller = checkcaller or function() return false end

local oldIndex = nil
if hookmetamethod then
    pcall(function()
        oldIndex = hookmetamethod(game, "__index", wrapClosure(function(self, idx)
            if _G.InstantAttack and not isCaller() and idx == "Visible" then
                if typeof(self) == "Instance" then
                    local name = self.Name
                    if name == "YourCard" or name == "EnemyCard" then
                        local isRam = true
                        local ok, fnName = pcall(debug.info, 2, "n")
                        if ok and type(fnName) == "string" and fnName ~= "" then
                            isRam = (fnName == "animateRam")
                        end
                        if isRam and _G.AttackDelay and _G.AttackDelay > 0 then
                            task.wait(_G.AttackDelay)
                        end
                        return false
                    end
                end
            end
            return oldIndex(self, idx)
        end))
    end)
end

local oldTweenCreate = nil
if hookfunction then
    pcall(function()
        oldTweenCreate = hookfunction(TweenService.Create, wrapClosure(function(self, inst, tweenInfo, props)
            if _G.InstantAttack and inst and typeof(inst) == "Instance" and isTowerAnimationInstance(inst) then
                local speed = _G.AttackDelay or 0
                local t = (speed > 0 and speed) or 0.001
                if typeof(tweenInfo) == "TweenInfo" then
                    tweenInfo = TweenInfo.new(t, tweenInfo.EasingStyle, tweenInfo.EasingDirection)
                else
                    tweenInfo = TweenInfo.new(t)
                end
            end
            return oldTweenCreate(self, inst, tweenInfo, props)
        end))
    end)
end

local oldNamecall = nil
if hookmetamethod then
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
            local method = getnamecallmethod()
            if _G.InstantAttack and (method == "Create" or method == "create") and self == TweenService then
                local args = {...}
                local inst = args[1]
                if inst and typeof(inst) == "Instance" and isTowerAnimationInstance(inst) then
                    local speed = _G.AttackDelay or 0
                    local t = (speed > 0 and speed) or 0.001
                    if typeof(args[2]) == "TweenInfo" then
                        args[2] = TweenInfo.new(t, args[2].EasingStyle, args[2].EasingDirection)
                    else
                        args[2] = TweenInfo.new(t)
                    end
                    if setnamecallmethod then
                        setnamecallmethod("Create")
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
end

local oldTaskWait = nil
if hookfunction then
    pcall(function()
        oldTaskWait = hookfunction(task.wait, wrapClosure(function(n)
            if _G.InstantAttack then
                local ok, src = pcall(debug.info, 2, "s")
                if ok and type(src) == "string" and (src:lower():find("tower") or src:lower():find("sequence")) then
                    local speed = _G.AttackDelay or 0
                    if speed > 0 then
                        return oldTaskWait(speed)
                    end
                    return oldTaskWait(0)
                end
            end
            return oldTaskWait(n)
        end))
    end)
end

