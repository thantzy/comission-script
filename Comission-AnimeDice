local function getRollRemote()
    if RollDiceFunction then return RollDiceFunction end
    local net = ReplicatedStorage:FindFirstChild("Network")
    if net then
        local rs = net:FindFirstChild("RollService")
        if rs and rs:FindFirstChild("RollDice") then
            return rs.RollDice
        end
    end
    return nil
end

local function executeRoll()
    local remote = getRollRemote()
    if remote then
        if typeof(remote) == "function" then
            return pcall(remote)
        elseif remote:IsA("RemoteFunction") then
            return pcall(function()
                return remote:InvokeServer()
            end)
        end
    end
    return false
end

