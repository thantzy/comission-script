local activeRollWorkers = 0
local function startRollWorker()
    task.spawn(function()
        activeRollWorkers = activeRollWorkers + 1
        while _G.FastRoll do
            pcall(executeRoll)
            local d = _G.RollDelay or 0.01
            if d > 0 then
                task.wait(d)
            else
                task.wait()
            end
        end
        activeRollWorkers = activeRollWorkers - 1
    end)
end

local function syncRollWorkers()
    local target = _G.FastRoll and (_G.RollThreads or 3) or 0
    while activeRollWorkers < target do
        startRollWorker()
    end
end

