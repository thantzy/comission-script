local function TambahKataKeKamus(clean)
    if #clean < 2 or KamusSet[clean] then return end
    KamusSet[clean] = true
    table.insert(KamusData, clean)

    local l1 = clean:sub(1, 1)
    local b1 = KamusByLetter[l1]
    if not b1 then
        b1 = {}
        KamusByLetter[l1] = b1
    end
    table.insert(b1, clean)

    local l2 = clean:sub(1, 2)
    local b2 = KamusByTwoLetters[l2]
    if not b2 then
        b2 = {}
        KamusByTwoLetters[l2] = b2
    end
    table.insert(b2, clean)

    if #clean >= 3 then
        local l3 = clean:sub(1, 3)
        local b3 = KamusByThreeLetters[l3]
        if not b3 then
            b3 = {}
            KamusByThreeLetters[l3] = b3
        end
        table.insert(b3, clean)
    end

    local s1 = clean:sub(-1)
    local bs1 = KamusBySuffix1[s1]
    if not bs1 then
        bs1 = {}
        KamusBySuffix1[s1] = bs1
    end
    table.insert(bs1, clean)

    local s2 = clean:sub(-2)
    local bs2 = KamusBySuffix2[s2]
    if not bs2 then
        bs2 = {}
        KamusBySuffix2[s2] = bs2
    end
    table.insert(bs2, clean)
end

local function IsInputElement(inst)
    if not inst then return true end
    if inst:IsA("TextBox") then return true end

    local curr = inst
    local depth = 0
    while curr and curr ~= PlayerGui and depth < 6 do
        local name = curr.Name:lower()
        if name:find("input") or name:find("type") or name:find("jawab")
            or name:find("answer") or name:find("textbox") or name:find("box")
            or name:find("chat") or name:find("bar") or name:find("entry")
            or name:find("typed") or name:find("write") or name:find("field")
            or name:find("keyboard") then
            return true
        end
        curr = curr.Parent
        depth = depth + 1
    end
    return false
end

local function EkstrakPrefix(str)
    if not str or type(str) ~= "string" then return nil end
    local clean = str:gsub("^%s*(.-)%s*$", "%1")
    if #clean == 0 then return nil end

    local setelahHuruf = clean:match("[Hh]urufnya%s+adalah%s*([%a]+)")
    if setelahHuruf and #setelahHuruf >= 1 and #setelahHuruf <= 3 then
        return setelahHuruf:lower()
    end

    local setelahTitikDua = clean:match("[Hh]uruf%s*:%s*([%a]+)") or clean:match("[Aa]walan%s*:%s*([%a]+)")
    if setelahTitikDua and #setelahTitikDua >= 1 and #setelahTitikDua <= 3 then
        return setelahTitikDua:lower()
    end

    local afterColon = clean:match(":%s*([%a]+)%s*$")
    if afterColon and #afterColon >= 1 and #afterColon <= 3 then
        return afterColon:lower()
    end

    local c1, c2, c3 = clean:match("^([%a])%s+([%a])%s+([%a])$")
    if c1 and c2 and c3 then
        return (c1 .. c2 .. c3):lower()
    end
    local e1, e2 = clean:match("^([%a])%s+([%a])$")
    if e1 and e2 then
        return (e1 .. e2):lower()
    end

    local standalone = clean:match("^([%a]+)$")
    if standalone and #standalone >= 1 and #standalone <= 2 then
        local lower = standalone:lower()
        local blacklist = {
            ["ok"] = true, ["lv"] = true, ["no"] = true, ["vs"] = true, ["go"] = true,
            ["id"] = true, ["ya"] = true, ["in"] = true, ["on"] = true, ["hp"] = true,
            ["to"] = true, ["xp"] = true, ["cd"] = true, ["ui"] = true
        }
        if not blacklist[lower] then
            return lower
        end
    end

    return nil
end

