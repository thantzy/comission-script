            TambahKataKeKamus(line)
        end

        if i % 1500 == 0 and (os.clock() - frameStart) > budget then
            if i % 30000 == 0 then
                local pct = math.floor((i / totalLines) * 100)
                BannerText.Text = string.format("⚡ Memuat: %d%% (%dk kata)...", pct, math.floor(#KamusData / 1000))
                UpdateWordList()
            end
            task.wait()
            frameStart = os.clock()
        end
    end

    BannerText.Text = string.format("✅ Kamus siap! (%d kata)", #KamusData)
    BannerText.TextColor3 = Palette.EmeraldAccent
    print(string.format("ThanHub: Berhasil memuat & mengindeks %d kata (Zero-Lag Engine).", #KamusData))
    UpdateWordList()
end)

