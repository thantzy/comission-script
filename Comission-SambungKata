local function CariPrefixDiLocalPlayer()
    local wordServer = PlayerGui:FindFirstChild("WordServer", true)
    if wordServer and wordServer:IsA("TextLabel") and not IsInputElement(wordServer) and wordServer.Visible and wordServer.Text ~= "" then
        if HookTextLabel then HookTextLabel(wordServer) end
        local p = EkstrakPrefix(wordServer.Text)
        if p and p ~= "" then
            return p, wordServer
        end
    end

    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= ScreenGui and gui.Enabled then
            for _, v in ipairs(gui:GetDescendants()) do
                if v:IsA("TextLabel") and not IsInputElement(v) and v.Visible and v.Text ~= "" then
                    local text = v.Text
                    if text:find("Hurufnya") or text:find("hurufnya") or text:find("Huruf:") or text:find("Awalan:") then
                        if HookTextLabel then HookTextLabel(v) end
                        local p = EkstrakPrefix(text)
                        if p and p ~= "" then
                            return p, v
                        end

                        local parent = v.Parent
                        if parent then
                            for _, sib in ipairs(parent:GetChildren()) do
                                if sib ~= v and sib:IsA("TextLabel") and not IsInputElement(sib) and sib.Visible and sib.Text ~= "" then
                                    local sibPfx = EkstrakPrefix(sib.Text)
                                    if sibPfx and sibPfx ~= "" then
                                        if HookTextLabel then HookTextLabel(sib) end
                                        return sibPfx, sib
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return nil, nil
end
