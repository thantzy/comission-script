-- Status UI Updater
local function UpdateTurnDisplay(isTurn, prefix)
    isMyTurn = isTurn
    local pfx = (prefix and prefix ~= "") and prefix:upper() or currentAwalan:upper()

    if isTurn then
        SubtitleTurn.Text = "● Giliran kamu! [ " .. pfx .. " ]"
        SubtitleTurn.TextColor3 = Palette.EmeraldAccent
        FloatDot.BackgroundColor3 = Palette.EmeraldAccent
    else
        SubtitleTurn.Text = "○ Menunggu giliran... [ " .. pfx .. " ]"
        SubtitleTurn.TextColor3 = Palette.TextMuted
        FloatDot.BackgroundColor3 = Palette.TextMuted
    end
end

-- Detection Engine
local function ApplyDetectedPrefix(prefix)
    if not prefix or prefix == "" then return end
    prefix = prefix:gsub("%s+", ""):lower()

    currentAwalan = prefix
    InputAwalan.Text = prefix

    UpdateTurnDisplay(isMyTurn, prefix)
    UpdateWordList()
end

-- 1. In-game Remote Event: UpdateWordIndex
if UpdateWordIndex then
    UpdateWordIndex.OnClientEvent:Connect(function(data)
        if typeof(data) ~= "table" then return end

        -- Sync all database words if sent
        if typeof(data.AllWords) == "table" then
            local count = 0
            for w, _ in pairs(data.AllWords) do
                if typeof(w) == "string" and #w > 1 then
                    local clean = w:lower():gsub("%s+", "")
                    if not KamusSet[clean] then
                        KamusSet[clean] = true
                        table.insert(KamusData, clean)
                        count = count + 1
                    end
                end
            end
            if count > 0 then
                UpdateWordList()
            end
            return
        end

        -- Word update on game board
        if typeof(data.NewWord) == "string" and #data.NewWord > 0 then
            local newWord = data.NewWord:lower():gsub("%s+", "")
            if not KamusSet[newWord] then
                KamusSet[newWord] = true
                table.insert(KamusData, newWord)
            end

            if deteksiPrefixEnabled then
                local nextPrefix = AmbilSukuKataTerakhir(newWord)
                ApplyDetectedPrefix(nextPrefix)
            end
        end
    end)
end

-- 2. In-game Remote Event: MatchUI
if MatchRemote then
    MatchRemote.OnClientEvent:Connect(function(action, value)
        if action == "StartTurn" then
            UpdateTurnDisplay(true, currentAwalan)
        elseif action == "EndTurn" or action == "GameEnd" then
            UpdateTurnDisplay(false, currentAwalan)
        end
    end)
end

