-- =========================================================================
-- ADVANCED GAME PREFIX SCANNER (Mendukung 1 Huruf, 2 Huruf 'PI', dsb)
-- =========================================================================
local function CariPrefixDiGame()
    -- 1. Cari TextLabel di PlayerGui (khususnya yang berisi 'Hurufnya adalah:', 'Huruf:', atau WordServer)
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= ScreenGui then
            for _, v in ipairs(gui:GetDescendants()) do
                if v:IsA("TextLabel") and v.Visible and v.Text ~= "" then
                    local text = v.Text
                    if text:find("Hurufnya") or text:find("hurufnya") or text:find("Huruf") or text:find("Soal") or v.Name == "WordServer" then
                        local p = EkstrakPrefix(text)
                        if p then
                            return p, v
                        end
                    end
                end
            end
        end
    end

    -- 2. Cari di BillboardGui / SurfaceGui pada Character LocalPlayer (di atas kepala atau badan)
    local char = LocalPlayer.Character
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                for _, lbl in ipairs(v:GetDescendants()) do
                    if (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Text ~= "" then
                        local p = EkstrakPrefix(lbl.Text)
                        if p then
                            return p, lbl
                        end
                    end
                end
            end
        end
    end

    -- 3. Cari di Workspace (meja bermain aktif)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local nameLower = obj.Name:lower()
            if nameLower:find("table") or nameLower:find("meja") or nameLower:find("match") or nameLower:find("game") then
                for _, v in ipairs(obj:GetDescendants()) do
                    if v:IsA("TextLabel") and v.Text ~= "" and (v.Text:find("Hurufnya") or v.Name == "WordServer") then
                        local p = EkstrakPrefix(v.Text)
                        if p then
                            return p, v
                        end
                    end
                end
            end
        end
    end

    return nil, nil
end

