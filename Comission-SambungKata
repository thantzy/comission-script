local hookedTextLabels = {}

local function ProcessPotentialPrefix(text, sourceInstance)
    if not text or typeof(text) ~= "string" or text == "" then return end
    if not deteksiPrefixEnabled then return end
    if sourceInstance and IsInputElement(sourceInstance) then return end

    local isExplicitPrompt = false
    local lowerText = text:lower()
    if lowerText:find("hurufnya") or lowerText:find("huruf:") or lowerText:find("awalan:") then
        isExplicitPrompt = true
    end

    if isMyTurn and turnPrefixLocked and not isExplicitPrompt then
        return
    end

    local pfx = EkstrakPrefix(text)
    if pfx and pfx ~= "" then
        if isMyTurn or CheckCurrentlyMyTurn() then
            if pfx ~= currentAwalan:lower() or not turnPrefixLocked then
                ApplyDetectedPrefix(pfx)
            end
        end
    end
end

local function HookTextLabel(lbl)
    if not lbl or not lbl:IsA("TextLabel") or hookedTextLabels[lbl] then return end
    if IsInputElement(lbl) then return end
    hookedTextLabels[lbl] = true

    lbl:GetPropertyChangedSignal("Text"):Connect(function()
        ProcessPotentialPrefix(lbl.Text, lbl)
    end)
    lbl:GetPropertyChangedSignal("Visible"):Connect(function()
        if lbl.Visible then
            ProcessPotentialPrefix(lbl.Text, lbl)
        end
    end)
end

