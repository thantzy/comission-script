-- Responsive viewport calculation
local function GetResponsiveSizes()
    local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    local w = math.clamp(vp.X - 28, 270, 310)
    local h = math.clamp(vp.Y - 80, 350, 420)
    return w, h
end

