local function GetResponsiveSizes()
    local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    local isMobile = (vp.Y < 500) or (vp.X < 850) or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)

    local w, h
    if isMobile then
        w = math.clamp(math.floor(vp.X * 0.35), 205, 225)
        h = math.clamp(math.floor(vp.Y * 0.70), 225, 265)
    else
        w = 225
        h = 275
    end
    return w, h
end

