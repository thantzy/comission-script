-- Render Engine
local renderId = 0

local function UpdateWordList()
    renderId = renderId + 1
    local currentId = renderId

    for _, child in ipairs(ScrollingList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local awalan = currentAwalan:lower():gsub("%s+", "")
    local akhiran = currentAkhiran:lower():gsub("%s+", "")

    local awalanDisp = awalan ~= "" and awalan:upper() or "*"
    local akhiranDisp = akhiran ~= "" and akhiran:upper() or "*"

    if awalan == "" and akhiran == "" then
        BannerText.Text = "💡 Ketik awalan atau akhiran untuk mencari kata."
        return
    end

    local results = {}
    local limit = 300
    local isFallback = false

    -- 1. Cari kata yang cocok dengan Awalan DAN Akhiran
    for _, word in ipairs(KamusData) do
        local mAwalan = (awalan == "") or (word:sub(1, #awalan) == awalan)
        local mAkhiran = (akhiran == "") or (word:sub(-#akhiran) == akhiran)

        if mAwalan and mAkhiran then
            table.insert(results, word)
            if #results >= limit then
                break
            end
        end
    end

    -- 2. Jika akhiran dicari tapi tidak ada kata yang cocok, alihkan ke akhiran lain
    if #results == 0 and akhiran ~= "" then
        isFallback = true
        for _, word in ipairs(KamusData) do
            local mAwalan = (awalan == "") or (word:sub(1, #awalan) == awalan)
            if mAwalan then
                table.insert(results, word)
                if #results >= limit then
                    break
                end
            end
        end
    end

    -- 3. Perbarui teks status banner
    if isFallback then
        BannerText.Text = string.format("⚠️ Akhiran [ %s ] tidak ada! Dialihkan ke kata lain (%d kata)", akhiranDisp, #results)
        BannerText.TextColor3 = Color3.fromRGB(255, 185, 45) -- Kuning peringatan
    elseif #results == 0 then
        BannerText.Text = string.format("❌ Tidak ada kata ditemukan untuk [ %s ]", awalanDisp)
        BannerText.TextColor3 = Color3.fromRGB(255, 95, 95) -- Merah
    else
        BannerText.Text = string.format("🔎 [ %s ] ➔ [ %s ]  •  %d kata ditemukan", awalanDisp, akhiranDisp, #results)
        BannerText.TextColor3 = Palette.TextSecondary
    end

    for idx, word in ipairs(results) do
        if currentId ~= renderId then break end

        local Card = Instance.new("TextButton")
        Card.Name = "Word_" .. idx
        Card.Size = UDim2.new(1, -4, 0, 36)
        Card.BackgroundColor3 = Palette.CardDark
        Card.BorderSizePixel = 0
        Card.Text = ""
        Card.AutoButtonColor = false
        Card.Parent = ScrollingList

        local CardCorner = Instance.new("UICorner")
        CardCorner.CornerRadius = UDim.new(0, 8)
        CardCorner.Parent = Card

        local CardStroke = Instance.new("UIStroke")
        CardStroke.Color = Palette.StrokeSubtle
        CardStroke.Thickness = 0.8
        CardStroke.Parent = Card

        -- Badge Left
        local badgeColor = Palette.BadgeCycle[((idx - 1) % #Palette.BadgeCycle) + 1]
        local Badge = Instance.new("Frame")
        Badge.Size = UDim2.new(0, 22, 0, 22)
        Badge.Position = UDim2.new(0, 7, 0.5, -11)
        Badge.BackgroundColor3 = badgeColor
        Badge.BorderSizePixel = 0
        Badge.Parent = Card

        local BadgeCorner = Instance.new("UICorner")
        BadgeCorner.CornerRadius = UDim.new(0, 6)
        BadgeCorner.Parent = Badge

        local BadgeText = Instance.new("TextLabel")
        BadgeText.Size = UDim2.new(1, 0, 1, 0)
        BadgeText.BackgroundTransparency = 1
        BadgeText.Font = Enum.Font.GothamBold
        BadgeText.Text = word:sub(1, 1):upper()
        BadgeText.TextSize = 12
        BadgeText.TextColor3 = Color3.fromRGB(255, 255, 255)
        BadgeText.Parent = Badge

        -- Word Label
        local WordLabel = Instance.new("TextLabel")
        WordLabel.Size = UDim2.new(1, -86, 1, 0)
        WordLabel.Position = UDim2.new(0, 36, 0, 0)
        WordLabel.BackgroundTransparency = 1
        WordLabel.Font = Enum.Font.GothamBold
        WordLabel.Text = word:upper()
        WordLabel.TextSize = 12
        WordLabel.TextColor3 = Palette.TextPrimary
        WordLabel.TextXAlignment = Enum.TextXAlignment.Left
        WordLabel.Parent = Card

        -- Copy Pill Indicator
        local CopyTag = Instance.new("TextLabel")
        CopyTag.Size = UDim2.new(0, 48, 0, 20)
        CopyTag.Position = UDim2.new(1, -54, 0.5, -10)
        CopyTag.BackgroundColor3 = Palette.ObsidianBase
        CopyTag.Font = Enum.Font.GothamBold
        CopyTag.Text = "SALIN"
        CopyTag.TextSize = 9
        CopyTag.TextColor3 = Palette.TextSecondary
        CopyTag.Parent = Card

        local CopyCorner = Instance.new("UICorner")
        CopyCorner.CornerRadius = UDim.new(0, 5)
        CopyCorner.Parent = CopyTag

        -- Micro Animations on Hover
        Card.MouseEnter:Connect(function()
            TweenService:Create(Card, TweenInfo.new(0.12), {BackgroundColor3 = Palette.CardDarkHover}):Play()
            TweenService:Create(CardStroke, TweenInfo.new(0.12), {Color = Palette.StrokeAccent}):Play()
        end)
        Card.MouseLeave:Connect(function()
            TweenService:Create(Card, TweenInfo.new(0.12), {BackgroundColor3 = Palette.CardDark}):Play()
            TweenService:Create(CardStroke, TweenInfo.new(0.12), {Color = Palette.StrokeSubtle}):Play()
        end)

        -- Tap to Copy Action
        Card.MouseButton1Click:Connect(function()
            pcall(function()
                setclipboard(word)
            end)
            CopyTag.Text = "✓ OKE!"
            CopyTag.TextColor3 = Palette.EmeraldAccent
            CopyTag.BackgroundColor3 = Palette.EmeraldGlowBg
            WordLabel.TextColor3 = Palette.EmeraldAccent

            task.wait(0.65)
            if CopyTag and WordLabel then
                CopyTag.Text = "SALIN"
                CopyTag.TextColor3 = Palette.TextSecondary
                CopyTag.BackgroundColor3 = Palette.ObsidianBase
                WordLabel.TextColor3 = Palette.TextPrimary
            end
        end)
    end
end

