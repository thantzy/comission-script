-- =========================================================================
-- ULTRA FAST SEARCH ENGINE (<0.1ms Multi-Tier Bucket Lookups)
-- =========================================================================
local function UpdateWordList()
    local awalan = currentAwalan:lower():gsub("%s+", "")
    local akhiran = currentAkhiran:lower():gsub("%s+", "")

    local awalanDisp = awalan ~= "" and awalan:upper() or "*"
    local akhiranDisp = akhiran ~= "" and akhiran:upper() or "*"

    if awalan == "" and akhiran == "" then
        BannerText.Text = "💡 Ketik awalan atau akhiran untuk mencari kata."
        BannerText.TextColor3 = Palette.TextSecondary
        for i = 1, #CardPool do
            CardPool[i].Hide()
        end
        return
    end

    -- Fast bucket candidate selection (O(1) retrieval)
    local candidates
    local exactPrefix = false

    if #awalan >= 3 and KamusByThreeLetters[awalan:sub(1, 3)] then
        candidates = KamusByThreeLetters[awalan:sub(1, 3)]
        exactPrefix = (#awalan == 3)
    elseif #awalan >= 2 and KamusByTwoLetters[awalan:sub(1, 2)] then
        candidates = KamusByTwoLetters[awalan:sub(1, 2)]
        exactPrefix = (#awalan == 2)
    elseif #awalan == 1 and KamusByLetter[awalan] then
        candidates = KamusByLetter[awalan]
        exactPrefix = true
    elseif #awalan == 0 and #akhiran >= 2 and KamusBySuffix2[akhiran:sub(-2)] then
        candidates = KamusBySuffix2[akhiran:sub(-2)]
        exactPrefix = false
    elseif #awalan == 0 and #akhiran == 1 and KamusBySuffix1[akhiran] then
        candidates = KamusBySuffix1[akhiran]
        exactPrefix = false
    else
        candidates = KamusData
        exactPrefix = false
    end

    local results = {}
    local limit = 150
    local isFallback = false

    local checkPrefix = (not exactPrefix) and (#awalan > 0)
    local checkSuffix = (#akhiran > 0)
    local awalanLen = #awalan
    local akhiranLen = #akhiran

    -- 1. Fast match on Awalan + Akhiran
    for i = 1, #candidates do
        local word = candidates[i]
        local match = true

        if checkPrefix and word:sub(1, awalanLen) ~= awalan then
            match = false
        end

        if match and checkSuffix and word:sub(-akhiranLen) ~= akhiran then
            match = false
        end

        if match then
            table.insert(results, word)
            if #results >= limit then
                break
            end
        end
    end

    -- 2. Fallback: If requested Akhiran has 0 matches, redirect to other available words with the same prefix!
    if #results == 0 and #akhiran > 0 then
        isFallback = true
        for i = 1, #candidates do
            local word = candidates[i]
            local match = true
            if checkPrefix and word:sub(1, awalanLen) ~= awalan then
                match = false
            end
            if match then
                table.insert(results, word)
                if #results >= limit then
                    break
                end
            end
        end
    end

    -- 3. Update status banner
    if isFallback then
        BannerText.Text = string.format("⚠️ Akhiran [ %s ] tidak ada! Dialihkan (%d kata)", akhiranDisp, #results)
        BannerText.TextColor3 = Color3.fromRGB(255, 185, 45)
    elseif #results == 0 then
        BannerText.Text = string.format("❌ Tidak ada kata untuk [ %s ]", awalanDisp)
        BannerText.TextColor3 = Color3.fromRGB(255, 95, 95)
    else
        BannerText.Text = string.format("🔎 [ %s ] ➔ [ %s ]  •  %d kata", awalanDisp, akhiranDisp, #results)
        BannerText.TextColor3 = Palette.TextSecondary
    end

    -- 4. Instant UI update using object pool (ZERO INSTANCE CREATION!)
    for i = 1, #results do
        local card = GetOrCreateCard(i)
        card.SetWord(results[i], i)
    end

    -- Hide remaining cards in the pool
    for i = #results + 1, #CardPool do
        CardPool[i].Hide()
    end
end

