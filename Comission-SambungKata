-- =========================================================================
-- HIGH PERFORMANCE DICTIONARY INDEXING (MULTI-TIER BUCKETS FOR <0.1ms SEARCH)
-- =========================================================================
local KamusData = {}              -- Flat list of unique words
local KamusSet = {}               -- O(1) deduplication set
local KamusByLetter = {}          -- 1-letter prefix: ['t'] = { ... }
local KamusByTwoLetters = {}       -- 2-letter prefix: ['ta'] = { ... }
local KamusByThreeLetters = {}     -- 3-letter prefix: ['tak'] = { ... }
local KamusBySuffix1 = {}          -- 1-letter suffix: ['i'] = { ... }
local KamusBySuffix2 = {}          -- 2-letter suffix: ['an'] = { ... }

local function TambahKataKeKamus(clean)
    if #clean < 2 or KamusSet[clean] then return end
    KamusSet[clean] = true
    table.insert(KamusData, clean)

    -- Prefix Buckets (1, 2, 3 letters)
    local l1 = clean:sub(1, 1)
    local b1 = KamusByLetter[l1]
    if not b1 then
        b1 = {}
        KamusByLetter[l1] = b1
    end
    table.insert(b1, clean)

    local l2 = clean:sub(1, 2)
    local b2 = KamusByTwoLetters[l2]
    if not b2 then
        b2 = {}
        KamusByTwoLetters[l2] = b2
    end
    table.insert(b2, clean)

    if #clean >= 3 then
        local l3 = clean:sub(1, 3)
        local b3 = KamusByThreeLetters[l3]
        if not b3 then
            b3 = {}
            KamusByThreeLetters[l3] = b3
        end
        table.insert(b3, clean)
    end

    -- Suffix Buckets (1, 2 letters)
    local s1 = clean:sub(-1)
    local bs1 = KamusBySuffix1[s1]
    if not bs1 then
        bs1 = {}
        KamusBySuffix1[s1] = bs1
    end
    table.insert(bs1, clean)

    local s2 = clean:sub(-2)
    local bs2 = KamusBySuffix2[s2]
    if not bs2 then
        bs2 = {}
        KamusBySuffix2[s2] = bs2
    end
    table.insert(bs2, clean)
end

-- Ekstraksi Prefix Pintar (Mendukung 1 huruf 'T', 2 huruf 'PI', format 'Hurufnya adalah: PI', dsb)
local function EkstrakPrefix(str)
    if not str or type(str) ~= "string" then return nil end
    local clean = str:gsub("^%s*(.-)%s*$", "%1")
    if #clean == 0 then return nil end

    -- Pattern 1: Teks setelah titik dua (misal "Hurufnya adalah: PI", "Huruf: T", "Soal: KA")
    local afterColon = clean:match(":%s*([%a]+)%s*$")
    if afterColon and #afterColon >= 1 and #afterColon <= 4 then
        return afterColon:lower()
    end

    -- Pattern 2: Dua huruf dipisah spasi (misal balok "P I")
    local c1, c2 = clean:match("^([%a])%s+([%a])$")
    if c1 and c2 then
        return (c1 .. c2):lower()
    end

    -- Pattern 3: Standalone 1 sampai 3 huruf (misal "PI", "T", "BER")
    local standalone = clean:match("^([%a][%a]?[%a]?)$")
    if standalone then
        return standalone:lower()
    end

    return nil
end

-- Pemenggalan suku kata terakhir bahasa Indonesia (KBBI)
local function AmbilSukuKataTerakhir(kata)
    if not kata or type(kata) ~= "string" then return "" end
    kata = kata:gsub("%s+", ""):lower()
    if #kata <= 2 then return kata end

    local vowels = {a = true, e = true, i = true, o = true, u = true}
    local vIndices = {}

    for i = 1, #kata do
        local c = kata:sub(i, i)
        if vowels[c] then
            table.insert(vIndices, i)
        end
    end

    if #vIndices == 0 or #vIndices == 1 then
        return kata
    end

    local lastV = vIndices[#vIndices]
    local prevV = vIndices[#vIndices - 1]

    local isDiphthong = (lastV == prevV + 1) and (lastV == #kata) and (kata:sub(prevV, lastV) == "ai" or kata:sub(prevV, lastV) == "au" or kata:sub(prevV, lastV) == "oi" or kata:sub(prevV, lastV) == "ei")

    local targetV = lastV
    local beforeV = prevV

    if isDiphthong then
        targetV = prevV
        if #vIndices >= 3 then
            beforeV = vIndices[#vIndices - 2]
        else
            beforeV = nil
        end
    end

    if not beforeV then
        local between = kata:sub(1, targetV - 1)
        if #between <= 1 then
            return kata
        else
            return kata:sub(#between)
        end
    end

    local between = kata:sub(beforeV + 1, targetV - 1)
    local startPos

    if between == "ng" or between == "ny" or between == "sy" or between == "kh" then
        startPos = beforeV + 1
    elseif #between >= 3 and (between:sub(1, 2) == "ng" or between:sub(1, 2) == "ny" or between:sub(1, 2) == "sy" or between:sub(1, 2) == "kh") then
        startPos = beforeV + 1 + 2
    elseif #between == 0 then
        startPos = targetV
    elseif #between == 1 then
        startPos = beforeV + 1
    else
        startPos = beforeV + 2
    end

    return kata:sub(startPos)
end

